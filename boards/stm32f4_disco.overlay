
/ {
	zephyr,user {
        pir-gpios       = <&gpioe 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; 
		pan-step-gpios  = <&gpioe 9  GPIO_ACTIVE_HIGH>;
		pan-dir-gpios   = <&gpioe 10 GPIO_ACTIVE_HIGH>;
		tilt-step-gpios = <&gpioe 11 GPIO_ACTIVE_HIGH>;
		tilt-dir-gpios  = <&gpioe 12 GPIO_ACTIVE_HIGH>;
	};
};

/* VL53L0X ToF sensor on I2C1: SCL = PB6, SDA = PB9 */
&i2c1 {
	tof: vl53l0x@29 {
		compatible = "st,vl53l0x";
		reg = <0x29>;
	};

 oled: ssd1306@3c {
                compatible = "solomon,ssd1306";
                reg = <0x3c>;
                width = <128>;
                height = <64>;
                segment-offset = <0>;
                page-offset = <0>;
                display-offset = <0>;
                multiplex-ratio = <63>;
                segment-remap;
                com-invdir;
                prechargep = <0x22>;
        };
};
